          "title": "Type",
          "type": "string"
        },
        "access": {
          "title": "Access",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "min": {
          "default": null,
          "title": "Min"
        },
        "max": {
          "default": null,
          "title": "Max"
        },
        "inc": {
          "default": null,
          "title": "Inc"
        },
        "symbolics": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
